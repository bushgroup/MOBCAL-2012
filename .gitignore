# Scratch directories the two gates build and run in. test/_bounds also holds
# the generated over-bound inputs, which are fixtures the gate writes rather
# than files anybody edits.
test/_work/
test/_bounds/

# Compiler and run leftovers, wherever they land.
*.exe
*.o
*.mod
mobcal_he
mobcal_n2

# The program writes these to the current directory under fixed names.
hold
temp.out
