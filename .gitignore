# Scratch directories the three gates build and run in. test/_bounds also holds
# the generated over-bound inputs, and test/_elements the generated probe
# driver -- fixtures the gates write rather than files anybody edits.
test/_work/
test/_bounds/
test/_elements/

# Compiler and run leftovers, wherever they land.
*.exe
*.o
*.mod
mobcal_he
mobcal_n2

# The program writes these to the current directory under fixed names.
hold
temp.out
